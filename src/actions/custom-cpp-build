name: 'Custom C++ Build'
description: 'Assembles a C++ source file using a specific command'

inputs:
  source-file:
    description: 'The C++ source file to compile'
    required: true
  output-file:
    description: 'The output executable name'
    required: true
  compiler-flags:
    description: 'Additional compiler flags'
    required: false
    default: '-std=c++17'

runs:
  using: 'composite'
  steps:
    - name: Compile C++ Source
      shell: bash
      run: |
        echo "Compiling ${{ inputs.source-file }}"
        g++ ${{ inputs.compiler-flags }} ${{ inputs.source-file }} -o ${{ inputs.output-file }}
        echo "Build successful!"   
